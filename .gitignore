node_modules/

# Editor / agent scratch state. Not project content.
.freebuff/

# Secrets. This project never needs your credentials — the app signs in through
# Instagram's own login screen and keeps the session in the platform's secure
# store. These patterns are here so an accidental file cannot be pushed.
.env
.env.*
*.secrets
*credentials*
credentials.json
secrets.json
*.keychain

# Generated by scripts/build.mjs. Run `npm run build` before opening the Xcode
# project — XcodeGen needs these to exist.
dist/
ios/FocusApp/Resources/
ios/FocusApp/GeneratedRoutes.swift
ios/FocusApp/Info.plist

# Xcode / XcodeGen output
ios/*.xcodeproj/
ios/*.xcworkspace/
ios/build/
*.ipa
*.xcarchive
DerivedData/
.DS_Store
